# Dedicated Visual Crossing Secret Manager diagnostic image.
# This image is NOT the subscriber backend. Build/push/deploy only after
# a separate review and explicit approval of infrastructure and costs.
# Base is pinned to the digest already reviewed in backend/Dockerfile.
FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

WORKDIR /app
COPY --chown=node:node src/rj-visual-crossing-runtime-secret-proof.mjs ./src/rj-visual-crossing-runtime-secret-proof.mjs
COPY --chown=node:node scripts/visual-crossing-runtime-secret-proof.mjs ./scripts/visual-crossing-runtime-secret-proof.mjs
USER node
ENV NODE_ENV=production

# No HTTP server, weather provider SDK, subscriber data or Secret API key in image.
# Default runtime is fail-closed unless executed in one specifically approved
# Cloud Run Job, with one task, approved env flag and matching service identity.
CMD ["node", "scripts/visual-crossing-runtime-secret-proof.mjs"]
